PORT=3000
JWT_SECRET=change-me

# Option 1: Use full connection URL (recommended for Supabase)
# Copy directly from Supabase connection string
DB_URL=postgresql://user:password@host:port/database

# Option 2: Use individual database settings (for local/custom setup)
DB_TYPE=postgres
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=skillbridge
DB_SSL=false

TYPEORM_SYNC=false
TYPEORM_MIGRATIONS_RUN=false
